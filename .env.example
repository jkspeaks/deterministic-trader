# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is gitignored. Never commit a filled-in copy.
#
# Read by the offline `ops/` scripts — `ops/supabase_client.py` loads it and
# `ops/control.py` uses it to reach Supabase. `scripts/install.py` copies this
# file to `.env`, prompts for the required values, and prints every tracked file
# a fork must still edit (workflows, config, docs).

# --- Required -----------------------------------------------------------------
# Supabase project URL and service_role key. The service_role key bypasses RLS
# by design: these scripts act as the operator, server-side, and match the same
# credential the hosted core and the routine use.
# Find both in Supabase -> Project Settings -> API.
EDGE_SUPABASE_URL=https://your-project.supabase.co
EDGE_SUPABASE_KEY=your-service-role-key

# --- Optional: hosted core / pre-market job / evidence ------------------------
# These are NOT read by the offline `ops/` scripts. They belong on the Vercel
# project (services/core) and, for the Telegram pair, in Supabase Vault. They
# are listed here so a fork has one place to record them; install.py fills in
# whichever you provide. SECRETS.md is the authoritative home of each.
# CORE_TOKEN=your-core-shared-secret
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# TWELVE_DATA_API_KEY=your-twelvedata-basic-key
# ALPHAVANTAGE_API_KEY=your-alphavantage-free-key
# The Telegram bot token and chat id live in Supabase Vault, not here:
#   select vault.create_secret('<token>', 'edge_telegram_bot_token');
#   select vault.create_secret('<chat id>', 'edge_telegram_chat_id');

# --- Optional: loader / state -------------------------------------------------
# Point the loader at one specific env file instead of the defaults it tries in
# order: $HOME/.env, $USERPROFILE/.env, <repo>/.env, <repo>/ops/.env.
# EDGE_ENV_FILE=/absolute/path/to/.env

# Where ops/control.py keeps its write-cooldown state, so a redelivered update
# cannot double-apply the same write. Defaults to .control-state.json (gitignored).
# EDGE_CONTROL_STATE=.control-state.json
# EDGE_CONTROL_COOLDOWN_S=10
